{
  "manifest_version": 3,
  "name": "Bitrix Task Files List",
  "version": "0.4.0",
  "description": "Highlights completed and deferred tasks in Bitrix; an optional clean file list with Lychee and Bambu Studio buttons is off by default.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
